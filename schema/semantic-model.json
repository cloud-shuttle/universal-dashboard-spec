{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cloud-shuttle/universal-dashboard-spec/schema/semantic-model.json",
  "title": "UDS Semantic Model (Metrics Layer)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "uds/v1" },
    "kind": { "const": "SemanticModel" },
    "metadata": {
      "type": "object",
      "required": ["name", "title"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["measures", "dimensions"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "entities": {
          "type": "array",
          "items": { "$ref": "#/$defs/entity" }
        },
        "dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "measures": {
          "type": "array",
          "items": { "$ref": "#/$defs/measure" }
        },
        "metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/metric" }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "description": "Physical source table, view, or table function. Set table or function.",
      "properties": {
        "database": { "type": "string" },
        "schema": { "type": "string" },
        "table": { "type": "string" },
        "function": {
          "type": "string",
          "description": "Table function, optionally schema-qualified, such as analytics.orders_for. Arguments are passed in map order."
        },
        "arguments": {
          "type": "object",
          "description": "Function arguments in call order. Each value names a parameter or a filter.",
          "additionalProperties": { "$ref": "#/$defs/sourceArgument" }
        }
      }
    },
    "sourceArgument": {
      "type": "object",
      "properties": {
        "parameter": { "type": "string", "description": "Dashboard parameter whose value is passed." },
        "filter": { "type": "string", "description": "Dashboard filter whose value is passed." },
        "default": { "description": "Value used when the control is empty." },
        "map": {
          "type": "object",
          "description": "Control value to the literal the function receives. year: 12 passes 12 when the control is year.",
          "additionalProperties": true
        }
      }
    },
    "entity": {
      "type": "object",
      "required": ["name", "type", "field"],
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["primary", "foreign"] },
        "field": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "dimension": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "type": { "enum": ["categorical", "time", "number"] },
        "field": { "type": "string" },
        "grains": {
          "type": "array",
          "items": { "enum": ["day", "week", "month", "quarter", "year"] },
          "description": "Allowed time grains (only for type=time)"
        },
        "description": { "type": "string" }
      }
    },
    "predicate": {
      "type": "object",
      "required": ["dimension", "operator", "value"],
      "properties": {
        "dimension": { "type": "string" },
        "operator": {
          "enum": ["eq", "neq", "in", "not_in", "gt", "gte", "lt", "lte"]
        },
        "value": {
          "description": "Comparison value. An array when operator is in or not_in."
        }
      }
    },
    "measure": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "aggregation": {
          "description": "Set this or expression, not both.",
          "enum": ["sum", "count", "count_distinct", "avg", "min", "max", "ltm"]
        },
        "expression": {
          "type": "string",
          "description": "Arithmetic over other measures, e.g. mrr - prev_mrr. Identifiers, numbers, + - * /, and parentheses. Set this or aggregation, not both."
        },
        "field": { "type": "string" },
        "format": { "type": "string" },
        "description": { "type": "string" },
        "where": {
          "type": "array",
          "description": "Row predicates. On an aggregation they limit the summed rows. On an expression they apply to every measure the expression uses.",
          "items": { "$ref": "#/$defs/predicate" }
        },
        "priorPeriod": { "$ref": "#/$defs/priorPeriod" }
      }
    },
    "priorPeriod": {
      "type": "object",
      "required": ["dimension", "offset"],
      "description": "The same aggregation shifted along a breakout. offset -1 is the previous period of that dimension. The widget must break out by the dimension.",
      "properties": {
        "dimension": { "type": "string" },
        "offset": { "type": "integer" }
      }
    },
    "metric": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "type": { "enum": ["simple", "ratio", "cumulative", "derived", "ltm"] },
        "description": { "type": "string" },
        "measure": { "type": "string", "description": "For type=simple or type=ltm" },
        "numerator": { "type": "string", "description": "For type=ratio" },
        "denominator": { "type": "string", "description": "For type=ratio" },
        "input_metric": { "type": "string", "description": "For type=cumulative" },
        "grain_to_date": { "enum": ["day", "week", "month", "quarter", "year"] },
        "expression": { "type": "string", "description": "Restricted expression for type=derived" }
      }
    }
  }
}
