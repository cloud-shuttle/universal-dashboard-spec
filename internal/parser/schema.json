{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cloud-shuttle/universal-dashboard-spec/schema/dashboard.json",
  "title": "Universal Dashboard Specification",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "uds/v1" },
    "kind": { "const": "Dashboard" },
    "metadata": {
      "type": "object",
      "required": ["name", "title"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["widgets"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "models": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Names of SemanticModels this dashboard references"
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" },
          "description": "User-set values that drive calculations or widget options (distinct from filters)"
        },
        "measures": {
          "type": "array",
          "items": { "$ref": "#/$defs/measure" }
        },
        "dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/filter" }
        },
        "tabs": {
          "type": "array",
          "items": { "$ref": "#/$defs/tab" }
        },
        "widgets": {
          "type": "array",
          "items": { "$ref": "#/$defs/widget" }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "description": "Optional source table for compilation targets that need it (e.g. Metabase).",
      "properties": {
        "database": { "type": "string" },
        "schema": { "type": "string" },
        "table": { "type": "string" },
        "function": {
          "type": "string",
          "description": "Table function, optionally schema-qualified. Arguments are passed in map order."
        },
        "arguments": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sourceArgument" }
        }
      }
    },
    "sourceArgument": {
      "type": "object",
      "properties": {
        "parameter": { "type": "string" },
        "filter": { "type": "string" },
        "default": {},
        "map": { "type": "object", "additionalProperties": true }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "type": {
          "enum": ["string", "number", "date", "boolean", "date_range"]
        },
        "values": {
          "description": "Allowed values (for radio / dropdown parameters)",
          "type": "array",
          "items": { "type": "string" }
        },
        "affects": {
          "description": "What this parameter changes",
          "enum": ["measure", "dimension", "title", "filter", "option"]
        },
        "swaps": {
          "description": "Map of parameter value → measure name when affects=measure",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "default": {},
        "required": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "predicate": {
      "type": "object",
      "required": ["dimension", "operator", "value"],
      "properties": {
        "dimension": { "type": "string" },
        "operator": {
          "enum": ["eq", "neq", "in", "not_in", "gt", "gte", "lt", "lte"]
        },
        "value": {
          "description": "Comparison value. An array when operator is in or not_in."
        }
      }
    },
    "pivotField": {
      "type": "object",
      "description": "One pivot axis entry. Set dimension or measure, not both.",
      "properties": {
        "dimension": { "type": "string" },
        "measure": { "type": "string" }
      }
    },
    "measure": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "aggregation": {
          "description": "Set this or expression, not both.",
          "enum": ["sum", "count", "count_distinct", "avg", "min", "max", "ltm"]
        },
        "expression": {
          "type": "string",
          "description": "Arithmetic over other measures, e.g. mrr - prev_mrr. Identifiers, numbers, + - * /, and parentheses. Set this or aggregation, not both."
        },
        "field": { "type": "string" },
        "format": { "type": "string" },
        "description": { "type": "string" },
        "where": {
          "type": "array",
          "description": "Row predicates. On an aggregation they limit the summed rows. On an expression they apply to every measure the expression uses.",
          "items": { "$ref": "#/$defs/predicate" }
        },
        "priorPeriod": { "$ref": "#/$defs/priorPeriod" }
      }
    },
    "priorPeriod": {
      "type": "object",
      "required": ["dimension", "offset"],
      "description": "The same aggregation shifted along a breakout. offset -1 is the previous period. The widget must break out by the dimension.",
      "properties": {
        "dimension": { "type": "string" },
        "offset": { "type": "integer" }
      }
    },
    "dimension": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "field": { "type": "string" },
        "type": { "enum": ["string", "number", "date", "boolean"] },
        "temporalGrain": {
          "enum": ["day", "week", "month", "quarter", "year"]
        }
      }
    },
    "filter": {
      "type": "object",
      "required": ["name"],
      "description": "Set dimension or bindings. bindings lets one control slice the same idea on more than one model.",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "dimension": { "type": "string" },
        "bindings": {
          "type": "array",
          "description": "Dimension names or model.dimension names this filter applies to.",
          "items": { "type": "string" },
          "minItems": 1
        },
        "searchable": {
          "type": "boolean",
          "description": "Show a search box on this control. Typical with multi_select."
        },
        "control": {
          "description": "UI control to render for this filter",
          "enum": ["dropdown", "multi_select", "radio", "date_picker", "date_range", "slider", "search"]
        },
        "values": {
          "description": "Allowed values for radio / dropdown filters",
          "type": "array",
          "items": { "type": "string" }
        },
        "multi": { "type": "boolean" },
        "cascadeFrom": {
          "description": "Name of another filter this one depends on",
          "type": "string"
        },
        "default": {},
        "required": { "type": "boolean" }
      }
    },
    "tab": {
      "type": "object",
      "required": ["name", "title"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "titleTemplate": {
          "description": "Dynamic tab title, e.g. '{{year}} ARR'",
          "type": "string"
        }
      }
    },
    "widget": {
      "type": "object",
      "required": ["id", "type", "title", "layout"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": [
            "line",
            "bar",
            "stacked_bar",
            "area",
            "pie",
            "table",
            "number",
            "scatter",
            "heatmap",
            "pivot",
            "combo",
            "diverging",
            "text",
            "image"
          ]
        },
        "intent": {
          "description": "Analytical message the widget is meant to convey. Optional in v1; see docs/taxonomy.md. Helps LLMs, validation, and multi-target compilation.",
          "enum": [
            "nominal_comparison",
            "ranking",
            "time_series",
            "part_to_whole",
            "deviation",
            "distribution",
            "correlation",
            "lookup"
          ]
        },
        "title": { "type": "string" },
        "titleTemplate": {
          "description": "Dynamic title, e.g. '{{period}} ARR'",
          "type": "string"
        },
        "tab": { "type": "string" },
        "measures": { "type": "array", "items": { "type": "string" } },
        "dimensions": { "type": "array", "items": { "type": "string" } },
        "filters": { "type": "array", "items": { "type": "string" } },
        "timeGrain": {
          "description": "Grain for this widget's time dimension. Overrides the dimension temporalGrain.",
          "enum": ["day", "week", "month", "quarter", "year"]
        },
        "content": {
          "description": "Body for type=text",
          "type": "string"
        },
        "src": {
          "description": "Image location for type=image",
          "type": "string"
        },
        "fixedFilters": {
          "description": "Constant predicates for this widget. Not user-facing controls.",
          "type": "array",
          "items": { "$ref": "#/$defs/predicate" }
        },
        "rows": {
          "description": "Pivot row order. Mix dimensions and measures.",
          "type": "array",
          "items": { "$ref": "#/$defs/pivotField" }
        },
        "columns": {
          "description": "Pivot column order. Mix dimensions and measures.",
          "type": "array",
          "items": { "$ref": "#/$defs/pivotField" }
        },
        "parameters": {
          "description": "Parameters this widget consumes",
          "type": "array",
          "items": { "type": "string" }
        },
        "actions": {
          "description": "Drill or navigation actions",
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "series": {
          "description": "Per-series styling and tooltips",
          "type": "array",
          "items": { "$ref": "#/$defs/series" }
        },
        "visibleWhen": {
          "description": "Show this widget only when a parameter has this value.",
          "$ref": "#/$defs/visibleWhen"
        },
        "layout": {
          "type": "object",
          "required": ["x", "y", "w", "h"],
          "description": "24-column grid. x/w are column units (0-23). y/h are row units. One row unit is approximately 30px in most targets; exact pixel height is target-dependent.",
          "properties": {
            "x": { "type": "integer", "minimum": 0, "maximum": 23 },
            "y": { "type": "integer", "minimum": 0 },
            "w": { "type": "integer", "minimum": 1, "maximum": 24 },
            "h": { "type": "integer", "minimum": 1 }
          }
        },
        "options": { "type": "object" }
      }
    },
    "series": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "type": {
          "description": "Series chart type for combo charts",
          "enum": ["line", "bar", "area"]
        },
        "axis": {
          "description": "Which axis this series uses",
          "enum": ["left", "right"]
        },
        "color": { "type": "string" },
        "tooltipFields": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "visibleWhen": {
      "type": "object",
      "required": ["parameter", "equals"],
      "properties": {
        "parameter": { "type": "string" },
        "equals": { "description": "The parameter value that shows the widget." }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["drill_to_dashboard", "drill_to_card", "url", "filter"]
        },
        "target": { "type": "string" },
        "parameterMappings": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
